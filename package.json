{
  "name": "matigr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "22.14.0", "npm": "10.9.2" },
  "packageManager": "npm@10.9.2",
  "workspaces": ["src/frontend/apps/web"],
  "scripts": {
    "test:contracts": "node --test tests/contracts/*.test.mjs",
