    RM1 --> TEAM

    E15 --> RM1

    C14 --> A6 --> E15
end

class A6 aggregate;
class C10,C11,C12,C13,C14 command;
class E10,E11,E12,E13,E14,E15 event;
class P2,P3,P4 rule;
class RM1 readmodel;


