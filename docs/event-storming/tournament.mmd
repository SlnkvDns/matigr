end

class A7 aggregate;
class C15,C16,C17,C18,C19 command;
class E16,E17,E18,E19,E20 event;
class P5,P6 rule;
class RM2,RM3 readmodel;


%% =========================================================
%% КОНТЕКСТ 4 — РЕЗУЛЬТАТЫ
%% =========================================================

subgraph BC4["Bounded Context: Результаты"]
    direction TB

    A8["Агрегат: Результат<br/>команды по задаче"]

    C20["Зафиксировать результат"]
    C21["Обновить результат"]

    E21["Результат по задаче зафиксирован"]
    E22["Результат по задаче изменён"]

    P7["Правильное решение →<br/>баллы задания<br/><br/>Неправильное решение → 0"]

    RM4["Модель чтения:<br/>Онлайн-турнирная таблица"]
    RM5["Модель чтения:<br/>Результаты команды"]
    RM6["Модель чтения:<br/>Результаты для организатора"]

    E17 --> P7
