%% =========================================================

subgraph BC3["Bounded Context: Проверка решений"]
    direction TB

    A7["Агрегат: Проверка"]

    C15["Взять следующую проверку"]
    C16["Отметить решение правильным"]
    C17["Отметить решение неправильным"]
    C18["Отказаться от проверки"]
    C19["Передать старшему жюри"]

    E16["Проверка назначена члену жюри"]
    E17["Решение признано правильным"]
    E18["Решение признано неправильным"]
    E19["Член жюри отказался от проверки"]
    E20["Проверка передана старшему жюри"]

    P5["Очередь отдаёт одну свободную<br/>проверку одному проверяющему"]
    P6["Отказ от проверки →<br/>передача старшему жюри"]

    RM2["Модель чтения:<br/>Очередь проверок"]
    RM3["Модель чтения:<br/>Очередь старшего жюри"]

    E13 --> RM2
    RM2 --> C15
    C15 --> A7 --> E16

    E16 --> RM2

    C16 --> A7 --> E17
    C17 --> A7 --> E18
    C18 --> A7 --> E19

    E19 --> P6 --> C19
    C19 --> A7 --> E20

    E20 --> RM3

    JURY --> C15
