flowchart LR

%% =========================================================
%% EVENT STORMING
%% Предметная область: Турнир "Матигр"
%% =========================================================

%% ---------- Стили Event Storming ----------

classDef event fill:#F4A261,stroke:#B55D00,stroke-width:1px,color:#111;
classDef command fill:#8DB9E8,stroke:#356EA5,stroke-width:1px,color:#111;
classDef aggregate fill:#F2C94C,stroke:#9A7A00,stroke-width:2px,color:#111;
classDef rule fill:#D889B8,stroke:#8A3F70,stroke-width:1px,color:#111;
classDef readmodel fill:#BFE67A,stroke:#689B2B,stroke-width:1px,color:#111;
classDef actor fill:#F7E7A5,stroke:#A68B28,stroke-width:1px,color:#111;
classDef external fill:#F3A6A6,stroke:#A63C3C,stroke-width:1px,color:#111;

%% =========================================================
%% АКТОРЫ
%% =========================================================

subgraph ACTORS["Акторы"]
    TEAM["Команда"]
    JURY["Член жюри"]
    SENIOR["Старший член жюри"]
    ORG["Организатор турнира"]
end

class TEAM,JURY,SENIOR,ORG actor;


%% =========================================================
%% КОНТЕКСТ 1 — УПРАВЛЕНИЕ ТУРНИРОМ
%% =========================================================

subgraph BC1["Bounded Context: Управление турниром"]
    direction TB

    A1["Агрегат: Турнир"]
    A2["Агрегат: Регистрация команды"]
    A3["Агрегат: Состав жюри"]
    A4["Агрегат: Задание"]
    A5["Агрегат: Бланк задания"]

    C1["Создать турнир"]
    C2["Зарегистрировать команду"]
    C3["Зарегистрировать члена жюри"]
    C4["Создать задание"]
    C5["Опубликовать задание"]
    C6["Сформировать QR-бланки"]
    C7["Выдать бланки командам"]
    C8["Начать турнир"]
    C9["Завершить турнир"]

    E1["Турнир создан"]
    E2["Команда зарегистрирована"]
    E3["Член жюри зарегистрирован"]
    E4["Задание создано"]
    E5["Задание опубликовано"]
    E6["QR-бланки сформированы"]
    E7["Бланки выданы командам"]
    E8["Турнир начался"]
    E9["Турнир завершён"]

    P1["После публикации задания<br/>сформировать QR-бланки"]

    C1 --> A1 --> E1
    C2 --> A2 --> E2
    C3 --> A3 --> E3
    C4 --> A4 --> E4
    C5 --> A4 --> E5

    E5 --> P1 --> C6
    C6 --> A5 --> E6

    C7 --> A5 --> E7
    C8 --> A1 --> E8
    C9 --> A1 --> E9
end

class A1,A2,A3,A4,A5 aggregate;
class C1,C2,C3,C4,C5,C6,C7,C8,C9 command;
class E1,E2,E3,E4,E5,E6,E7,E8,E9 event;
class P1 rule;


%% =========================================================
%% КОНТЕКСТ 2 — ПРИЁМ РЕШЕНИЙ
%% =========================================================

subgraph BC2["Bounded Context: Приём решений"]
    direction TB

    A6["Агрегат: Решение"]

    C10["Загрузить фотографию решения"]
    C11["Распознать QR-код"]
    C12["Проверить QR и бланк"]
    C13["Поставить решение в очередь проверки"]
    C14["Закрыть приём решений"]

    E10["Фотография решения загружена"]
    E11["QR-код распознан"]
    E12["Решение идентифицировано"]
    E13["Решение принято на проверку"]
    E14["Решение отклонено:<br/>недействительный QR"]
    E15["Приём решений закрыт"]

    P2["Фото содержит QR-код"]
    P3["QR соответствует существующим<br/>команде и задаче"]
    P4["Турнир активен и приём решений открыт"]

    RM1["Модель чтения:<br/>Статусы отправленных решений"]

    C10 --> A6 --> E10
    E10 --> P2 --> C11
    C11 --> QR_DECODER
    QR_DECODER --> E11

    E11 --> C12
    C12 --> A6

    A6 --> E12
    A6 --> E14

    E12 --> P3 --> P4 --> C13
    C13 --> A6 --> E13

    E13 --> RM1
